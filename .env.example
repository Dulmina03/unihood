# Local development only. Copy to .env; never use these credentials publicly.
APP_ENV=local
WEB_PORT=3000
API_PORT=3001
API_HOST=127.0.0.1
POSTGRES_USER=unihood
POSTGRES_PASSWORD=unihood_local_only
POSTGRES_DB=unihood_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://unihood:unihood_local_only@127.0.0.1:5432/unihood_dev
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql://unihood_test:unihood_test_only@127.0.0.1:5433/unihood_test
# Server-only fixed upstream for read-only university adapters (no identity headers forwarded).
API_BASE_URL=http://127.0.0.1:3001/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api/v1
# Optional provider configuration; bootstrap makes no map requests.
NEXT_PUBLIC_MAP_STYLE_URL=
# Synthetic actor adapter: local/test only, explicit opt-in, loopback API binding.
# Server selects one synthetic fixture; no HTTP header can choose or elevate it.
# Never expose this development server via a public proxy/tunnel.
ENABLE_SYNTHETIC_ACTORS=false
# Optional fixtures: contributor, owner-a, price-manager-a. Blank/unknown means guest.
SYNTHETIC_ACTOR=
