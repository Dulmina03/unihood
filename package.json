{
  "name": "unihood",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @unihood/contracts build && pnpm --parallel --filter @unihood/web --filter @unihood/api dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --filter @unihood/contracts build && pnpm -r typecheck",
    "test": "node --test scripts/lib/database.test.mjs scripts/check-repository.test.mjs && pnpm --filter @unihood/contracts build && pnpm -r test",
    "build": "pnpm -r build",
    "test:e2e": "node scripts/test-phase-one.mjs",
    "db:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait db",
    "db:down": "docker compose --env-file .env -f infra/compose.yaml stop db",
    "db:migrate": "node --env-file-if-exists=.env scripts/db.mjs migrate",
    "db:rollback": "node --env-file-if-exists=.env scripts/db.mjs rollback",
    "db:test": "node --env-file-if-exists=.env scripts/test-database.mjs",
    "db:test:up": "docker compose --env-file .env -f infra/compose.yaml --profile test up -d --wait db-test",
    "db:test:down": "docker compose --env-file .env -f infra/compose.yaml --profile test rm --stop --force db-test",
    "db:seed": "node --env-file-if-exists=.env scripts/db.mjs seed",
    "db:test:extensions": "node scripts/test-db-extensions.mjs",
    "test:ui": "pnpm --filter @unihood/web test:ui",
    "check:repo": "node scripts/check-repository.mjs",
    "check:workflows": "bash scripts/check-workflows.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "yaml": "2.9.1"
  }
}
